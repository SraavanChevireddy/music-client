_MusicFeedModel _$MusicFeedModelFromJson(Map<String, dynamic> json) =>
    _MusicFeedModel(
      feed: FeedModel.fromJson(json['feed'] as Map<String, dynamic>),
    );

Map<String, dynamic> _$MusicFeedModelToJson(_MusicFeedModel instance) =>
    <String, dynamic>{'feed': instance.feed};

_FeedModel _$FeedModelFromJson(Map<String, dynamic> json) => _FeedModel(
  title: json['title'] as String,
  id: json['id'] as String,
  author: AuthorModel.fromJson(json['author'] as Map<String, dynamic>),
  copyright: json['copyright'] as String?,
  country: json['country'] as String?,
  updated: json['updated'] as String?,
  results:
      (json['results'] as List<dynamic>?)
          ?.map((e) => SongItemModel.fromJson(e as Map<String, dynamic>))
          .toList() ??
      const [],
);

Map<String, dynamic> _$FeedModelToJson(_FeedModel instance) =>
    <String, dynamic>{
      'title': instance.title,
      'id': instance.id,
      'author': instance.author,
      'copyright': instance.copyright,
      'country': instance.country,
      'updated': instance.updated,
      'results': instance.results,
    };

_AuthorModel _$AuthorModelFromJson(Map<String, dynamic> json) =>
    _AuthorModel(name: json['name'] as String, url: json['url'] as String?);

Map<String, dynamic> _$AuthorModelToJson(_AuthorModel instance) =>
    <String, dynamic>{'name': instance.name, 'url': instance.url};

_SongItemModel _$SongItemModelFromJson(Map<String, dynamic> json) =>
    _SongItemModel(
      id: json['id'] as String,
      name: json['name'] as String,
      artistName: json['artistName'] as String,
      kind: json['kind'] as String,
      artistId: json['artistId'] as String?,
      artistUrl: json['artistUrl'] as String?,
      releaseDate: json['releaseDate'] as String?,
      artworkUrl100: json['artworkUrl100'] as String?,
      contentAdvisoryRating: json['contentAdvisoryRating'] as String?,
      url: json['url'] as String?,
      genres:
          (json['genres'] as List<dynamic>?)
              ?.map((e) => GenreModel.fromJson(e as Map<String, dynamic>))
              .toList() ??
          const [],
    );

Map<String, dynamic> _$SongItemModelToJson(_SongItemModel instance) =>
    <String, dynamic>{
      'id': instance.id,
      'name': instance.name,
      'artistName': instance.artistName,
      'kind': instance.kind,
      'artistId': instance.artistId,
      'artistUrl': instance.artistUrl,
      'releaseDate': instance.releaseDate,
      'artworkUrl100': instance.artworkUrl100,
      'contentAdvisoryRating': instance.contentAdvisoryRating,
      'url': instance.url,
      'genres': instance.genres,
    };

_GenreModel _$GenreModelFromJson(Map<String, dynamic> json) => _GenreModel(
  genreId: json['genreId'] as String,
  name: json['name'] as String,
  url: json['url'] as String?,
);

Map<String, dynamic> _$GenreModelToJson(_GenreModel instance) =>
    <String, dynamic>{
      'genreId': instance.genreId,
      'name': instance.name,
      'url': instance.url,
    };
